# Server Configuration
HOST=0.0.0.0
PORT=8000

# Dev-only: uvicorn file-watching auto-reload. Leave at false on any
# deployed/production instance - a reloader restarts the whole server on
# every write under the watch root, including the writes a `git pull`
# makes. Set to true only on a local dev checkout you are actively editing.
# Must be a valid bool literal (true/false), not empty - pydantic-settings
# treats a present-but-empty value as an invalid bool, not "unset".
CLOUDE_DEV_RELOAD=false

# Session Configuration
DEFAULT_WORKING_DIR=~/cloude-projects
SESSION_TIMEOUT=3600

# Claude CLI Configuration
# Path to the Claude CLI binary. If not set, will auto-detect using:
# 1. `which claude` (if in PATH)
# 2. ~/.claude/local/claude
# 3. Fallback to just "claude"
CLAUDE_CLI_PATH=/path/to/claude

# Logging
LOG_BUFFER_SIZE=1000
LOG_FILE_RETENTION=7

# State directory - where session_metadata.json, pinned_themes.json,
# unread_state.json, refresh_tokens.db, and cloude.db live. Defaults to
# the macOS-native ~/Library/Application Support/CloudeCode when unset -
# leave this blank unless you need the data somewhere else. Set it to a
# writable path if the default cannot be created; the server refuses to
# start rather than silently falling back to a temp directory.
CLOUDE_STATE_DIR=

# LEGACY - superseded by CLOUDE_STATE_DIR above. No longer read as the
# state write target. Left unset on a fresh install. Only set this if you
# are upgrading a pre-existing install whose data still lives at its old
# LOG_DIRECTORY location - the app reads session_metadata.json /
# pinned_themes.json / unread_state.json from there as a fallback if the
# new location does not have them yet.
LOG_DIRECTORY=

# Security (Optional)
API_KEY=
# ALLOWED_ORIGINS defaults to ["*"] - only set if you need to restrict origins

# Authentication Secrets
# Generated by setup_auth.py - DO NOT COMMIT THESE VALUES
TOTP_SECRET=
JWT_SECRET=

# Authentication Configuration
# Path to config.json (contains projects, template_path, etc - NOT secrets)
AUTH_CONFIG_FILE=./config.json

# --- Docker (Mode 2) ---
# Set to a specific LAN IP (not 0.0.0.0) to expose only on your home network.
# Run scripts/preflight-bind-ip.sh to list available IPs.
# Default 127.0.0.1 keeps it loopback-only if unset.
CLOUDE_BIND_IP=127.0.0.1
# Host path to mount as /workspace inside the container
CLOUDE_PROJECT_PATH=./projects
# Host path for the state directory (session metadata, pinned themes,
# unread state, refresh_tokens.db, cloude.db) - bind-mounted into the
# container so it survives container recreation.
CLOUDE_LOG_DIR=./logs
# User ID mapping — export these before docker compose build to match host perms:
#   UID=$(id -u) GID=$(id -g) docker compose build

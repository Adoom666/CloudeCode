# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# Environment Variables
.env
.env.local
# Every .env sidecar. A dated .env.bak from a deploy was found untracked
# and NOT ignored on 2026-08-16, one `git add .` from publishing the TOTP
# and JWT secrets. .env.example is negated below so it stays tracked.
.env.*
!.env.example
config.json
# The app rewrites config.json in place and drops the previous copy beside it
# as config.json.bak (and dated config.json.bak.<stamp> variants). Those are
# copies of a real runtime config, so they carry exactly the same secrets
# config.json does and must never be committed. Ignoring config.json alone
# does not cover them: the pattern is literal, not a prefix.
config.json.bak
config.json.bak.*
# Naming the .bak family alone was still too narrow. Every deploy this session
# wrote a hand-taken config.json.pre<reason>-<date> beside it, and those are
# whole live configs too. Ignore the entire sidecar family instead of chasing
# one suffix at a time. This glob only matches names beginning "config.json.",
# so config.example.json (the committed, sanitized template) is unaffected.
config.json.*

# Authentication
totp-qr.png
# TOTP pairing sentinel (runtime state)
.totp_paired

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
/tmp/
*.log.*

# Session Data
session_metadata.json
pinned_themes.json
unread_state.json
/claude-projects/

# Image Uploads (per-session bucket — must never be committed)
.cloude_uploads/

# Auth State (refresh-token store - must never be committed)
refresh_tokens.db

# EVERY SQLite database, and every JSONL transcript archive.
#
# Naming refresh_tokens.db alone was far too narrow for THIS repository,
# whose entire subject is SQLite corpora and JSONL transcript archives. A
# dev checkout routinely has a multi-gigabyte cloude.db sitting in it (the
# live corpus is 15 GB) and JSONL exports of real conversations. Either one
# is a single `git add .` away from being committed, and a transcript is
# private content, not just a large file. Ignore the FAMILY, not one name.
#
# Checked before adding (2026-08-31): `git ls-files` matches nothing under
# any of these patterns, so no tracked file is being hidden.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.jsonl

# Local git worktrees. `git worktree add .worktrees/<x>` is the spawn pattern
# used here; the directory is another checkout, never content of this one.
.worktrees/

# unittest.mock artifact. A MagicMock name used as a path in a test creates a
# literal directory tree named MagicMock/ in the repo root.
MagicMock/

# Dated runtime state dumps, e.g. 20260828T200717Z.json - migration-trail and
# self-check snapshots the app writes beside its config. Runtime state, never
# source. Anchored to the ISO-ish stamp so ordinary .json files (theme.json,
# config.example.json, .mcp.json) are untouched.
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.json

# Test Coverage
.coverage
htmlcov/
.pytest_cache/

# Claude
.prompt_history/
troubleshooting/

.superpowers/

# Runtime lock files (session-scoped, PID-stamped — never meant to be tracked)
.claude/scheduled_tasks.lock

# CLAUDE.md is TRACKED here on purpose. It is the repo's agent orientation
# doc, not a personal scratch file. A global excludesFile that ignores
# CLAUDE.md would otherwise keep it out of every commit silently; this
# negation wins because repo .gitignore is read after core.excludesFile.
!CLAUDE.md

# Build-only workspace for the vendored CodeMirror bundle (see
# client/vendor/codemirror/VERSION.md). node_modules and the lockfile are
# build inputs, not runtime code; only the built bundle under client/vendor/
# ships.
scripts/codemirror-vendor/node_modules
scripts/codemirror-vendor/node_modules.nosync/
scripts/codemirror-vendor/package-lock.json

# Release self-check cache. Written next to config.json inside whatever source
# root the server runs from (see src/core/update_check.py CACHE_FILENAME); in a
# dev checkout that root is this repo. Runtime state, never tracked.
.update-check.json

# electron-builder output. The .dmg is a release artifact, not source.
# Both plain and .nosync-suffixed forms: iCloud Drive checkouts on this
# fleet get a <name>.nosync real directory plus a <name> symlink pointing at
# it (see build/build.nosync below), and a plain trailing-slash pattern does
# NOT match a symlink, only a real directory - each form needs its own line.
macOS/dist
macOS/dist.nosync/
macOS/node_modules
macOS/node_modules.nosync/

# Top-level build output workspace, same symlink-plus-.nosync shape as
# macOS/dist above.
/build
/build.nosync/

# Screenshots from scripts/verify/measure-theme-effect-visibility.py
scripts/verify/.theme-effect-shots/

# Screenshots from scripts/verify/measure-terminal-opacity.py
scripts/verify/.terminal-opacity-shots/
.upgrade-baselines/

# Upgrade artifacts. Never pruned automatically; prune by hand.
.upgrade-backups/

# SHIP the project's slash commands. The user's GLOBAL gitignore carries a
# blanket `.claude/` rule, which would silently keep .claude/commands out of
# the repository and make /upgrade unavailable to every other user - the
# exact opposite of the point. A repo .gitignore outranks the global one, so
# un-ignore the directory, re-ignore its local-only contents, then allow
# commands/ back in.
!.claude/
.claude/*
!.claude/commands/
